<!DOCTYPE html>
<html lang="{{ lang | default('en') }}" data-theme="light">

<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/x-icon" href="{{ public('img/lila.png') }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - {{ model_name.capitalize() }} | Lila</title>
  {% include "lila/tailwind.jinja" %}
</head>

<body class="bg-bg-body dark:bg-bg-body-dark text-slate-800 dark:text-slate-200 transition-colors duration-300 font-sans min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8">
    <!-- Persistent Sidebar -->
    <aside data-persist="true" id="admin-sidebar" class="w-full md:w-64 flex-shrink-0">
      {{ menu | safe }}
    </aside>

    <!-- Main CRUD Workspace in Lila Outlet -->
    <main id="lila-outlet" data-lila-outlet class="flex-1 space-y-6">
      <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-surface dark:bg-surface-dark border border-slate-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm">
        <div>
          <h2 class="text-2xl font-black bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
            {{ model_name.capitalize() }} Management
          </h2>
          <p class="text-xs text-slate-400 font-semibold mt-1">Live Database CRUD & Telemetry</p>
        </div>
        <div class="flex items-center gap-3">
          <a href="/admin/api/{{ model_plural }}/export" target="_blank" class="btn bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs px-3.5 py-2">
            <span>📥</span> Export CSV
          </a>
          <button onclick="openCreateModal()" class="btn btn-primary text-xs px-4 py-2 shadow-sm">
            <span>➕</span> New {{ model_name.capitalize() }}
          </button>
        </div>
      </header>

      <article class="card p-6">
        <div id="table" class="overflow-x-auto"></div>
      </article>
    </main>
  </div>

  <!-- Record Modal (Create / Edit) -->
  <dialog id="recordModal" class="rounded-2xl p-6 bg-surface dark:bg-surface-dark border border-slate-200 dark:border-slate-800 shadow-xl max-w-md w-full backdrop:bg-slate-950/40">
    <div class="flex items-center justify-between mb-4 border-b border-slate-100 dark:border-slate-800 pb-3">
      <h3 id="modalTitle" class="text-lg font-bold text-slate-900 dark:text-white">New {{ model_name.capitalize() }}</h3>
      <button onclick="document.getElementById('recordModal').close()" class="text-slate-400 hover:text-slate-600 text-lg cursor-pointer">&times;</button>
    </div>
    <form id="recordForm" class="space-y-4">
      <input type="hidden" id="recordId" name="id" value="" />
      <div id="formFields" class="space-y-3">
        {% for header in headers %}
        {% if header != 'id' and header != 'created_at' and header != 'updated_at' %}
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">{{ header }}</label>
          <input type="text" name="{{ header }}" id="field_{{ header }}" class="w-full px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
        </div>
        {% endif %}
        {% endfor %}
      </div>
      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
        <button type="button" onclick="document.getElementById('recordModal').close()" class="btn bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs px-4 py-2">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary text-xs px-4 py-2">
          Save Record
        </button>
      </div>
    </form>
  </dialog>

  <script src="{{ public('js/lila-client.js') }}"></script>
  <script>
    const MODEL_PLURAL = "{{ model_plural }}";
    let dataTableInstance = null;

    function renderAdminTable(data) {
      dataTableInstance = new ResponsiveDataTable('table', {
        data: data,
        columns: [
          {% for header in headers %}
          { title: "{{ header.capitalize() }}", key: "{{ header }}" },
          {% endfor %}
        ],
        rowsPerPage: 10,
        search: true,
        pagination: true,
        edit: (e, item) => openEditModal(item),
        delete: (e, item) => deleteRecord(item),
        headerTitles: { "id": "ID" },
        summaryFields: ['id']
      });
    }

    async function loadData() {
      try {
        const res = await Http(`/admin/api/${MODEL_PLURAL}`);
        if (res.items) {
          renderAdminTable(res.items);
        }
      } catch (err) {
        console.error(err);
      }
    }

    function openCreateModal() {
      document.getElementById('modalTitle').textContent = 'New {{ model_name.capitalize() }}';
      document.getElementById('recordId').value = '';
      document.getElementById('recordForm').reset();
      document.getElementById('recordModal').showModal();
    }

    async function openEditModal(item) {
      const id = typeof item === 'object' ? item.id : item;
      try {
        const res = await Http(`/admin/api/${MODEL_PLURAL}/${id}`);
        const data = res.item || item;
        document.getElementById('modalTitle').textContent = `Edit {{ model_name.capitalize() }} #${id}`;
        document.getElementById('recordId').value = id;
        for (const [key, val] of Object.entries(data)) {
          const input = document.getElementById(`field_${key}`);
          if (input) input.value = val !== null && val !== undefined ? val : '';
        }
        document.getElementById('recordModal').showModal();
      } catch (err) {
        lila('toast', { title: 'Error', description: 'Failed to load record details', type: 'error' });
      }
    }

    async function deleteRecord(item) {
      const id = typeof item === 'object' ? item.id : item;
      if (!confirm(`Are you sure you want to delete ${id}?`)) return;
      try {
        const res = await Http(`/admin/api/${MODEL_PLURAL}/${id}`, 'DELETE');
        if (res.success) {
          lila('toast', { title: 'Deleted', description: res.message || 'Record removed.', type: 'success' });
          loadData();
        } else {
          lila('toast', { title: 'Error', description: res.message, type: 'error' });
        }
      } catch (err) {
        lila('toast', { title: 'Error', description: err.message, type: 'error' });
      }
    }

    document.getElementById('recordForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = Object.fromEntries(new FormData(e.target));
      const id = formData.id;
      delete formData.id;
      try {
        let res;
        if (id) {
          res = await Http(`/admin/api/${MODEL_PLURAL}/${id}`, 'PUT', formData);
        } else {
          res = await Http(`/admin/api/${MODEL_PLURAL}`, 'POST', formData);
        }
        if (res.success) {
          lila('toast', { title: 'Success', description: res.message || 'Saved successfully', type: 'success' });
          document.getElementById('recordModal').close();
          loadData();
        } else {
          lila('toast', { title: 'Error', description: res.message, type: 'error' });
        }
      } catch (err) {
        lila('toast', { title: 'Error', description: err.message, type: 'error' });
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      const initialData = {{ items_json | safe if items_json is defined else '[]' }};
      if (initialData && initialData.length > 0) {
        renderAdminTable(initialData);
      } else {
        loadData();
      }
    });
  </script>
</body>

</html>
