<!DOCTYPE html>
<html lang="{{ lang | default('en') }}" data-theme="light">

<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/x-icon" href="{{ public('favicon.ico') }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - {{ model_name.capitalize() }} | Lila</title>
  {% include "lila/tailwind.jinja" %}
</head>

<body class="bg-bg-body dark:bg-bg-body-dark text-slate-800 dark:text-slate-200 transition-colors duration-300 font-sans min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8">
    <aside data-persist="true" id="admin-sidebar" class="w-full md:w-64 flex-shrink-0">
      {{ menu | safe }}
    </aside>

    <main id="lila-outlet" data-lila-outlet class="flex-1 space-y-6">
      <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-surface dark:bg-surface-dark border border-slate-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm">
        <div>
          <h2 class="text-2xl font-black bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
            {{ model_name.capitalize() }} Management
          </h2>
          <p class="text-xs text-slate-400 font-semibold mt-1">Live Database CRUD &amp; Telemetry</p>
        </div>
        <div class="flex items-center gap-3">
          <a href="{{ admin_prefix | default('/admin') }}/api/{{ model_plural }}/export" target="_blank" data-no-router class="btn bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs px-3.5 py-2">
            <span>📥</span> Export CSV
          </a>
          <button onclick="openCreateModal()" class="btn btn-primary text-xs px-4 py-2 shadow-sm cursor-pointer">
            <span>➕</span> New {{ model_name.capitalize() }}
          </button>
        </div>
      </header>

      <article class="card p-6">
        <div id="table" class="overflow-x-auto"></div>
      </article>

      <!-- Record Modal (Centered via m-auto fixed inset-0) -->
      <dialog id="recordModal" class="m-auto fixed inset-0 rounded-2xl p-6 bg-surface dark:bg-surface-dark border border-slate-200 dark:border-slate-800 shadow-2xl max-w-md w-full backdrop:bg-slate-950/40">
        <div class="flex items-center justify-between mb-4 border-b border-slate-100 dark:border-slate-800 pb-3">
          <h3 id="modalTitle" class="text-lg font-bold text-slate-900 dark:text-white">New {{ model_name.capitalize() }}</h3>
          <button onclick="document.getElementById('recordModal').close()" class="text-slate-400 hover:text-slate-600 text-lg cursor-pointer">&times;</button>
        </div>
        <form id="recordForm" class="space-y-4">
          <input type="hidden" id="recordId" name="id" value="" />
          <div id="formFields" class="space-y-3">
            {% for field in form_columns %}
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">
                {{ field.name.replace('_', ' ').capitalize() }}
                {% if field.required and field.name != 'password' %}<span class="text-red-500">*</span>{% endif %}
              </label>
              {% if field.name == 'password' %}
              <input type="password" name="password" id="field_password" placeholder="••••••••" class="w-full px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
              {% elif field.input_type == 'active_select' %}
              <select name="active" id="field_active" class="w-full px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm">
                <option value="1">Active</option>
                <option value="0">Inactive</option>
              </select>
              {% elif field.input_type == 'boolean_select' %}
              <select name="{{ field.name }}" id="field_{{ field.name }}" class="w-full px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm">
                <option value="true">True</option>
                <option value="false">False</option>
              </select>
              {% elif field.input_type == 'number' %}
              <input type="number" step="any" name="{{ field.name }}" id="field_{{ field.name }}" class="w-full px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20" {% if field.required %}required{% endif %} />
              {% elif field.input_type == 'date' %}
              <input type="date" name="{{ field.name }}" id="field_{{ field.name }}" class="w-full px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20" {% if field.required %}required{% endif %} />
              {% elif field.input_type == 'datetime-local' %}
              <input type="datetime-local" name="{{ field.name }}" id="field_{{ field.name }}" class="w-full px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20" {% if field.required %}required{% endif %} />
              {% else %}
              <input type="text" name="{{ field.name }}" id="field_{{ field.name }}" class="w-full px-3.5 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20" {% if field.required %}required{% endif %} />
              {% endif %}
            </div>
            {% endfor %}
          </div>
          <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
            <button type="button" onclick="document.getElementById('recordModal').close()" class="btn bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs px-4 py-2 cursor-pointer">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary text-xs px-4 py-2 cursor-pointer">
              Save Record
            </button>
          </div>
        </form>
      </dialog>

      <script>
        (function() {
          const ADMIN_PREFIX = {{ admin_prefix | default('/admin') | tojson }};
          const MODEL_PLURAL = {{ model_plural | tojson }};
          let dataTableInstance = null;

          function renderAdminTable(data) {
            if (!document.getElementById('table')) return;
            if (window.__lilaAdminTable && typeof window.__lilaAdminTable.destroy === 'function') {
              window.__lilaAdminTable.destroy();
            }
            dataTableInstance = new ResponsiveDataTable('table', {
              data: data || [],
              columns: [
                {% for header in headers %}
                { title: {{ header.replace('_', ' ').capitalize() | tojson }}, key: {{ header | tojson }} },
                {% endfor %}
              ],
              rowsPerPage: 10,
              search: true,
              pagination: true,
              edit: (e, item) => openEditModal(item),
              delete: (e, item) => deleteRecord(item),
              headerTitles: { "id": "ID" },
              summaryFields: ['id']
            });
            window.__lilaAdminTable = dataTableInstance;
          }

          async function loadData() {
            try {
              const res = await Http(`${ADMIN_PREFIX}/api/${MODEL_PLURAL}`);
              const rows = Array.isArray(res) ? res : (res && (res.items || res.data)) || [];
              renderAdminTable(rows);
            } catch (err) {
              console.error(err);
            }
          }

          window.openCreateModal = function() {
            const modal = document.getElementById('recordModal');
            if (!modal) return;
            document.getElementById('modalTitle').textContent = 'New {{ model_name.capitalize() }}';
            document.getElementById('recordId').value = '';
            document.getElementById('recordForm').reset();
            const pwInput = document.getElementById('field_password');
            if (pwInput) {
              pwInput.required = true;
              pwInput.placeholder = '••••••••';
            }
            modal.showModal();
          };

          window.openEditModal = async function(item) {
            const modal = document.getElementById('recordModal');
            if (!modal) return;
            const id = typeof item === 'object' ? item.id : item;
            try {
              const res = await Http(`${ADMIN_PREFIX}/api/${MODEL_PLURAL}/${id}`);
              const data = res.item || res.data || res;
              document.getElementById('modalTitle').textContent = `Edit {{ model_name.capitalize() }} #${id}`;
              document.getElementById('recordId').value = id;
              for (const [key, val] of Object.entries(data || {})) {
                const input = document.getElementById(`field_${key}`);
                if (input) input.value = val !== null && val !== undefined ? val : '';
              }
              const pwInput = document.getElementById('field_password');
              if (pwInput) {
                pwInput.required = false;
                pwInput.placeholder = 'Leave blank to keep current';
                pwInput.value = '';
              }
              modal.showModal();
            } catch (err) {
              lila('toast', { title: 'Error', description: 'Failed to load record details', type: 'error' });
            }
          };

          window.deleteRecord = async function(item) {
            const id = typeof item === 'object' ? item.id : item;
            if (!confirm(`Are you sure you want to delete #${id}?`)) return;
            try {
              const res = await Http(`${ADMIN_PREFIX}/api/${MODEL_PLURAL}/${id}`, 'DELETE');
              if (res && res.success) {
                lila('toast', { title: 'Deleted', description: res.message || 'Record removed.', type: 'success' });
                loadData();
              } else {
                lila('toast', { title: 'Error', description: (res && res.message) || 'Delete failed', type: 'error' });
              }
            } catch (err) {
              lila('toast', { title: 'Error', description: err.message, type: 'error' });
            }
          };

          const formEl = document.getElementById('recordForm');
          if (formEl) {
            formEl.onsubmit = async function(e) {
              e.preventDefault();
              const formData = Object.fromEntries(new FormData(e.target));
              const id = formData.id;
              delete formData.id;
              try {
                let res;
                if (id) {
                  res = await Http(`${ADMIN_PREFIX}/api/${MODEL_PLURAL}/${id}`, 'PUT', formData);
                } else {
                  res = await Http(`${ADMIN_PREFIX}/api/${MODEL_PLURAL}`, 'POST', formData);
                }
                if (res && res.success) {
                  lila('toast', { title: 'Success', description: res.message || 'Saved successfully', type: 'success' });
                  document.getElementById('recordModal').close();
                  loadData();
                } else {
                  lila('toast', { title: 'Error', description: (res && res.message) || 'Operation failed', type: 'error' });
                }
              } catch (err) {
                lila('toast', { title: 'Error', description: err.message, type: 'error' });
              }
            };
          }

          function initModelTable() {
            let initialData = {{ items_json | tojson }};
            if (typeof initialData === 'string') {
              try { initialData = JSON.parse(initialData); } catch (e) { initialData = []; }
            }
            if (!Array.isArray(initialData)) initialData = [];
            renderAdminTable(initialData);
            if (initialData.length === 0) loadData();
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initModelTable, { once: true });
          } else {
            initModelTable();
          }
        })();
      </script>
    </main>
  </div>

  <script src="{{ public('js/lila-client.js') }}"></script>
</body>

</html>
