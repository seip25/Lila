<!DOCTYPE html>
<html lang="{{ lang | default('en') }}" data-theme="light">

<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/x-icon" href="{{ public('favicon.ico') }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Lila Framework</title>
  {% include "lila/tailwind.jinja" %}
</head>

<body class="bg-bg-body dark:bg-bg-body-dark text-slate-800 dark:text-slate-200 transition-colors duration-300 font-sans min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8">
    <aside data-persist="true" id="admin-sidebar" class="w-full md:w-64 flex-shrink-0">
      {{ menu | safe }}
    </aside>

    <main id="lila-outlet" data-lila-outlet class="flex-1 space-y-6">
      <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-surface dark:bg-surface-dark border border-slate-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm">
        <div>
          <h2 class="text-2xl font-black bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
            Admin Dashboard
          </h2>
          <p class="text-xs text-slate-400 mt-1 font-semibold">Lila Engine v2.0 Live Telemetry</p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="purgeCache()" class="btn bg-blue-50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/40 text-xs px-3.5 py-2">
            <span>⚡</span> Purge Cache
          </button>
          <button onclick="clearLogs()" class="btn bg-red-50 dark:bg-red-950/20 text-red-500 border border-red-200 dark:border-red-900/30 text-xs px-3.5 py-2">
            <span>🧹</span> Clear Logs
          </button>
        </div>
      </header>

      {% if not metrics.psutil_available %}
      <div class="rounded-xl border border-amber-200 bg-amber-50 dark:bg-amber-950/20 dark:border-amber-900/40 p-3 text-xs text-amber-800 dark:text-amber-200">
        <code>psutil</code> is not installed; Lila is using native OS fallbacks for the
        available metrics. Install it with <code>pip install "lila-framework[metrics]"</code>.
      </div>
      {% endif %}

      <article class="card p-6">
        <h4 class="text-base font-bold tracking-tight mb-6 flex items-center gap-2">
          <span>⚡</span> Server &amp; Telemetry Metrics
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Lila Memory</span>
            <span class="text-2xl font-black text-slate-900 dark:text-slate-100">
              {% if metrics.process_memory_mb is not none %}{{ "%.1f"|format(metrics.process_memory_mb) }}{% else %}n/a{% endif %}
            </span>
            <span class="text-xs font-semibold text-slate-400">MB</span>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Lila CPU</span>
            <span class="text-2xl font-black text-slate-900 dark:text-slate-100">
              {% if metrics.process_cpu is not none %}{{ "%.1f"|format(metrics.process_cpu) }}{% else %}n/a{% endif %}
            </span>
            <span class="text-xs font-semibold text-slate-400">%</span>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Cache Driver</span>
            <span class="text-2xl font-black text-blue-600 dark:text-blue-400">{{ cache_stats.driver | default('memory') }}</span>
            <span class="text-xs font-semibold text-slate-400 block mt-0.5">{{ cache_stats.memory_items | default(0) }} items</span>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">System Memory</span>
            <span class="text-lg font-black text-slate-900 dark:text-slate-100">
              {% if metrics.system_used_mb is not none %}
                {{ "%.0f"|format(metrics.system_used_mb) }} / {{ "%.0f"|format(metrics.system_total_mb) }}
              {% else %}n/a{% endif %}
            </span>
            <span class="text-xs font-semibold text-slate-400">MB</span>
          </div>
        </div>
      </article>

      <article class="card p-6">
        <h4 class="text-base font-bold tracking-tight mb-4 flex items-center gap-2">
          <span>📁</span> Recent Log Activity
        </h4>
        {% if logs %}
          {% for log in logs %}
          <details class="mb-2" {% if loop.first %}open{% endif %}>
            <summary class="cursor-pointer text-xs font-bold text-slate-600 dark:text-slate-300">
              {{ log.date }} / {{ log.file }}
            </summary>
            <pre class="mt-2 text-[11px] leading-relaxed font-mono bg-slate-50 dark:bg-slate-900/60 p-4 rounded-xl border border-slate-200 dark:border-slate-800 overflow-x-auto max-h-72">{% for line in log.lines %}{{ line }}
{% endfor %}</pre>
          </details>
          {% endfor %}
        {% else %}
        <p class="text-xs text-slate-400 italic">No log entries found. Enable <code>logging=True</code> in App() to record requests.</p>
        {% endif %}
      </article>
    </main>
  </div>

  <script src="{{ public('js/lila-client.js') }}"></script>
  <script>
    const ADMIN_PREFIX = {{ admin_prefix | default('/admin') | tojson }};
    async function purgeCache() {
      try {
        const res = await Http(`${ADMIN_PREFIX}/cache/clear`, 'POST', {});
        if (res.success) {
          lila('toast', { title: 'Cache Cleared', description: res.message || 'Cache emptied successfully', type: 'success' });
        } else {
          lila('toast', { title: 'Notice', description: res.message, type: 'info' });
        }
      } catch (err) {
        lila('toast', { title: 'Error', description: err.message, type: 'error' });
      }
    }

    async function clearLogs() {
      if (!confirm('Delete all log files?')) return;
      try {
        const res = await Http(`${ADMIN_PREFIX}/logs`, 'DELETE');
        if (res.success) {
          lila('toast', { title: 'Logs Cleared', description: res.message || 'Logs purged.', type: 'success' });
          setTimeout(() => window.location.reload(), 500);
        }
      } catch (err) {
        lila('toast', { title: 'Error', description: err.message, type: 'error' });
      }
    }
  </script>
</body>

</html>
