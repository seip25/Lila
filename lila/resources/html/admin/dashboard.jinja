<!DOCTYPE html>
<html lang="{{ lang | default('en') }}" data-theme="light">

<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/x-icon" href="{{ public('img/lila.png') }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Lila Framework</title>
  {% include "lila/tailwind.jinja" %}
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-bg-body dark:bg-bg-body-dark text-slate-800 dark:text-slate-200 transition-colors duration-300 font-sans min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-8">
    <!-- Persistent Sidebar Menu -->
    <aside data-persist="true" id="admin-sidebar" class="w-full md:w-64 flex-shrink-0">
      {{ menu | safe }}
    </aside>

    <!-- Main Workspace in Lila Outlet -->
    <main id="lila-outlet" data-lila-outlet class="flex-1 space-y-6">
      <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-surface dark:bg-surface-dark border border-slate-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm">
        <div>
          <h2 class="text-2xl font-black bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
            Admin Dashboard
          </h2>
          <p class="text-xs text-slate-400 mt-1 font-semibold">Lila Engine v2.0.0 Active Telemetry</p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="purgeCache()" class="btn bg-blue-50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/40 text-xs px-3.5 py-2">
            <span>⚡</span> Purge Cache
          </button>
          <button onclick="clearLogs()" class="btn bg-red-50 dark:bg-red-950/20 text-red-500 border border-red-200 dark:border-red-900/30 text-xs px-3.5 py-2">
            <span>🧹</span> Clear Logs
          </button>
        </div>
      </header>

      <!-- Server Metrics Section -->
      <article class="card p-6">
        <h4 class="text-base font-bold tracking-tight mb-6 flex items-center gap-2">
          <span>⚡</span> Server & Telemetry Metrics
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Lila Memory</span>
            <span class="text-2xl font-black text-slate-900 dark:text-slate-100" id="lilaMemory">{{ lila_memory | round(1) }}</span>
            <span class="text-xs font-semibold text-slate-400">MB</span>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Lila CPU</span>
            <span class="text-2xl font-black text-slate-900 dark:text-slate-100" id="lilaCpuUsage">{{ lila_cpu_usage | round(1) }}</span>
            <span class="text-xs font-semibold text-slate-400">%</span>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Cache Driver</span>
            <span class="text-2xl font-black text-blue-600 dark:text-blue-400" id="cacheDriver">{{ cache_stats.driver if cache_stats is defined else 'memory' }}</span>
            <span class="text-xs font-semibold text-slate-400 block mt-0.5">{{ cache_stats.memory_items if cache_stats is defined else '0' }} items</span>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">System Memory</span>
            <span class="text-lg font-black text-slate-900 dark:text-slate-100">
              <span id="systemUsedMemory">{{ system_used_memory | round(0) }}</span> / <span id="systemTotalMemory">{{ system_total_memory | round(0) }}</span>
            </span>
            <span class="text-xs font-semibold text-slate-400">MB</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center">
            <h5 class="text-xs font-bold uppercase text-slate-400 mb-2">Memory Utilization</h5>
            <div class="w-40 h-40 relative"><canvas id="memoryDoughnutChart"></canvas></div>
          </div>
          <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center">
            <h5 class="text-xs font-bold uppercase text-slate-400 mb-2">CPU Utilization</h5>
            <div class="w-40 h-40 relative"><canvas id="cpuDoughnutChart"></canvas></div>
          </div>
        </div>
      </article>

      <!-- Logs Section -->
      <article class="card p-6">
        <h4 class="text-base font-bold tracking-tight mb-4 flex items-center gap-2">
          <span>📁</span> Recent Log Activity
        </h4>
        {% if logs_html %}
        <div class="prose dark:prose-invert max-w-none text-xs font-mono bg-slate-50 dark:bg-slate-900/60 p-4 rounded-xl border border-slate-200 dark:border-slate-800 overflow-x-auto max-h-96">
          {{ logs_html | safe }}
        </div>
        {% else %}
        <p class="text-xs text-slate-400 italic">No log entries found for today.</p>
        {% endif %}
      </article>
    </main>
  </div>

  <script src="{{ public('js/lila-client.js') }}"></script>
  <script>
    async function purgeCache() {
      try {
        const res = await Http('/admin/cache/clear', 'POST', {});
        if (res.success) {
          lila('toast', { title: 'Cache Cleared', description: res.message || 'Cache emptied successfully', type: 'success' });
        } else {
          lila('toast', { title: 'Notice', description: res.message, type: 'info' });
        }
      } catch (err) {
        lila('toast', { title: 'Error', description: err.message, type: 'error' });
      }
    }

    async function clearLogs() {
      if (!confirm('Are you sure you want to delete past log files?')) return;
      try {
        const res = await Http('/admin/logs', 'DELETE');
        if (res.success) {
          lila('toast', { title: 'Logs Cleared', description: 'Log directory purged.', type: 'success' });
          setTimeout(() => window.location.reload(), 500);
        }
      } catch (err) {
        lila('toast', { title: 'Error', description: err.message, type: 'error' });
      }
    }

    // Chart.js initialization
    document.addEventListener('DOMContentLoaded', () => {
      try {
        const memCtx = document.getElementById('memoryDoughnutChart');
        if (memCtx) {
          const used = {{ system_used_memory | default(100) }};
          const total = {{ system_total_memory | default(1000) }};
          new Chart(memCtx, {
            type: 'doughnut',
            data: {
              labels: ['Used', 'Free'],
              datasets: [{
                data: [used, Math.max(0, total - used)],
                backgroundColor: ['#3b82f6', '#e2e8f0'],
                borderWidth: 0
              }]
            },
            options: { cutout: '75%', plugins: { legend: { display: false } } }
          });
        }

        const cpuCtx = document.getElementById('cpuDoughnutChart');
        if (cpuCtx) {
          const cpu = {{ cpu_usage | default(10) }};
          new Chart(cpuCtx, {
            type: 'doughnut',
            data: {
              labels: ['Used', 'Idle'],
              datasets: [{
                data: [cpu, Math.max(0, 100 - cpu)],
                backgroundColor: ['#8b5cf6', '#e2e8f0'],
                borderWidth: 0
              }]
            },
            options: { cutout: '75%', plugins: { legend: { display: false } } }
          });
        }
      } catch (e) {}
    });
  </script>
</body>

</html>
