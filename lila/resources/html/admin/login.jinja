<!DOCTYPE html>
<html lang="{{ lang | default('en') }}" data-theme="light">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/x-icon" href="{{ public('img/lila.png') }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login - Lila Framework</title>
  {% include "lila/tailwind.jinja" %}
</head>

<body class="bg-bg-body dark:bg-bg-body-dark min-h-screen flex flex-col items-center justify-center p-4 transition-colors duration-300 font-sans">
  <div class="min-h-screen w-full flex items-center justify-center p-4">
    <main class="w-full max-w-md">
      <div class="card p-8 shadow-lg">
        <div class="flex flex-col items-center mb-6">
          <img src="{{ public('img/lila.png') }}" alt="Lila" width="56" height="56" class="bg-white p-1 rounded-2xl shadow-sm mb-3">
          <h3 class="text-2xl font-black bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Lila Admin</h3>
          <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-widest font-bold mt-1">v2.0 Control Panel</p>
        </div>

        <form id="loginForm" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-2">Username or Email</label>
            <input type="text" name="user" id="user" required minlength="2" maxlength="255" placeholder="admin" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all text-slate-800 dark:text-slate-100 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-2">Password</label>
            <input type="password" name="password" id="password" required minlength="2" maxlength="255" placeholder="••••••••" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all text-slate-800 dark:text-slate-100 text-sm" />
          </div>
          <button type="submit" class="btn btn-primary w-full py-3 text-sm shadow-md mt-2">
            Sign In
          </button>
        </form>
      </div>
    </main>
  </div>

  <script src="{{ public('js/lila-client.js') }}"></script>
  <script>
    document.getElementById("loginForm").addEventListener("submit", async function (event) {
      event.preventDefault();
      const formData = Object.fromEntries(new FormData(event.target));
      try {
        const response = await Http("/admin/login", "POST", formData);
        if (response.success) {
          lila('toast', { title: 'Welcome', description: 'Redirecting to admin dashboard...', type: 'success' });
          setTimeout(() => {
            window.location.href = response.redirect || "/admin";
          }, 300);
        } else {
          document.getElementById("password").value = "";
          lila('toast', { title: 'Authentication Failed', description: response.message || 'Invalid credentials', type: 'error' });
        }
      } catch (error) {
        lila('toast', { title: 'Error', description: error.message || 'Failed to sign in', type: 'error' });
      }
    });
  </script>
</body>

</html>
