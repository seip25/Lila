{#- Base layout for transactional emails: tables + inline styles (Gmail/Outlook safe).
    Usage: {% extends "emails/base.jinja" %}{% set subject = "Welcome" %}
           {% block content %}<p>Hi {{ name }}</p>{% endblock %} -#}
<!DOCTYPE html>
<html lang="{{ lang | default('en') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <title>{{ subject | default(project) }}</title>
</head>
<body style="margin:0;padding:0;background:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#1e293b;">
  {% if preheader is defined %}<div style="display:none;max-height:0;overflow:hidden;">{{ preheader }}</div>{% endif %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9;padding:32px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e2e8f0;">
        <tr><td style="padding:24px 32px;border-bottom:1px solid #e2e8f0;font-size:18px;font-weight:800;color:#1a73e8;">
          {% block header %}{{ project }}{% endblock %}
        </td></tr>
        <tr><td style="padding:32px;font-size:15px;line-height:1.6;">
          {% block content %}{% endblock %}
        </td></tr>
        <tr><td style="padding:20px 32px;background:#f8fafc;font-size:12px;color:#64748b;">
          {% block footer %}{{ project }}{% if app_url %} · <a href="{{ app_url }}" style="color:#64748b;">{{ app_url }}</a>{% endif %}{% endblock %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
