<!DOCTYPE html>
<html lang="{{ lang | default('en') }}" data-theme="light">

<head>
  {% set lila_head_title = false %}
  <title>{% block title %}{{ page_meta.full_title if page_meta and page_meta.full_title else (title | default('Lila')) }}{% endblock %}</title>
  {% include "lila/head.jinja" %}
  {# In <head> so inline page scripts can use lila(), Http(), lilaSSE()... on
     the first load too (it is small, minified and cached; it waits for the DOM itself). #}
  <script src="{{ public('js/lila-client.js') }}"></script>
  {% block head %}{% endblock %}
</head>

<body data-layout="{{ layout_id | default('default') }}"
  class="{{ page_meta.body_class if page_meta and page_meta.body_class else 'min-h-screen bg-bg-body dark:bg-bg-body-dark text-slate-800 dark:text-slate-200 transition-colors duration-300 font-sans flex flex-col' }}">

  <div id="lila-outlet" data-lila-outlet class="flex-1 flex flex-col">
    {% block content %}{% endblock %}
  </div>

  {% block scripts %}{% endblock %}
</body>

</html>
