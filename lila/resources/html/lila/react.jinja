{#- React shell rendered by lila.core.react.react_render / router.spa().
    <head> comes from lila/head.jinja (title, meta, Open Graph, JSON-LD...);
    the page payload (component, props, csrf, desktop) is escaped JSON. -#}
<!DOCTYPE html>
<html lang="{{ lang | default('en') }}" data-theme="light">
<head>
  {% include "lila/head.jinja" %}
  <script{{ nonce_attr | default('') }}>try{var t=localStorage.getItem("lila-theme");if(t==="dark"||(!t&&matchMedia("(prefers-color-scheme: dark)").matches)){document.documentElement.dataset.theme="dark";document.documentElement.classList.add("dark")}}catch(e){}</script>
  {{ vite_tags }}
</head>
<body data-layout="react"{% if page_meta and page_meta.body_class %} class="{{ page_meta.body_class }}"{% endif %}>
  <div id="{{ react_root_id }}" data-lila-react>{{ react_skeleton }}</div>
  <script type="application/json" id="lila-page">{{ react_page }}</script>
  {{ react_dev_reload | default('') }}
</body>
</html>
