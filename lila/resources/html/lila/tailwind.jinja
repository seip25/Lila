    --color-primary: var(--primary, #1a73e8);
    --color-primary-dark: var(--primary-dark, #1557b0);
    --color-secondary: var(--secondary, #8b5cf6);
    --color-secondary-dark: var(--secondary-dark, #7c3aed);
