<!-- CSRF token for fetch/Http() on every page (kept in sync by render()). -->
<meta name="csrf-token" content="{{ csrf_token | default('') }}">
{% if debug %}
<meta name="lila-debug" content="1">{% endif %}

{% set _compiled_css = tailwind_css() %}
{% if _compiled_css %}
<!-- Compiled with `lila css build` (minified, no runtime). -->
<link rel="stylesheet" href="{{ _compiled_css }}">
{% else %}
<!-- Tailwind CSS browser runtime (zero build step, used in development).
     Run `lila css build` before deploying to serve a small compiled CSS. -->
<script src="{{ public('js/tailwind.js') }}" {{ nonce_attr | default('') }}></script>

<style type="text/tailwindcss">
  @custom-variant dark (&:where([data-theme=dark], [data-theme=dark] *));

  @theme {
    --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    --font-heading: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;

    --color-lila-50: #faf5ff;
    --color-lila-100: #f3e8ff;
    --color-lila-200: #e9d5ff;
    --color-lila-300: #d29bfd;
    --color-lila-400: #d38aff;
    --color-lila-500: #be79e1;
    --color-lila-600: #8b5cf6;
    --color-lila-700: #7c3aed;
    --color-lila-800: #6d28d9;
    --color-lila-900: #4c1d95;
    --color-lila-950: #241242;

    --color-primary: var(--primary, #7c3aed);
    --color-primary-dark: var(--primary-dark, #6d28d9);
    --color-secondary: var(--secondary, #be79e1);
    --color-secondary-dark: var(--secondary-dark, #9333ea);
    --color-accent: var(--accent, #d29bfd);
    --color-surface: var(--surface, #ffffff);
    --color-surface-dark: var(--surface-dark, #141124);
    --color-bg-body: var(--bg-body, #faf8ff);
    --color-bg-body-dark: var(--bg-body-dark, #0b0914);

    --color-lila-bg: var(--lila-bg, #faf8ff);
    --color-lila-surface: var(--lila-surface, #ffffff);
    --color-lila-primary: var(--lila-primary, #7c3aed);
    --color-lila-primary-hover: var(--lila-primary-hover, #6d28d9);
    --color-lila-sidebar: var(--lila-sidebar, #f4effc);
  }

  :root {
    color-scheme: light;
    --primary: #7c3aed;
    --primary-dark: #6d28d9;
    --secondary: #be79e1;
    --secondary-dark: #9333ea;
    --accent: #8b5cf6;
    --surface: #ffffff;
    --surface-dark: #141124;
    --bg-body: #faf8ff;
    --bg-body-dark: #0b0914;

    --lila-bg: #faf8ff;
    --lila-surface: #ffffff;
    --lila-primary: #7c3aed;
    --lila-primary-hover: #6d28d9;
    --lila-sidebar: #f4effc;

    --shadow-lila-card: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    --shadow-lila-card-hover: 0 10px 25px -4px rgba(124, 58, 237, 0.16);
    --shadow-lila-input: 0 2px 6px 0 rgba(0, 0, 0, 0.03);
    --shadow-lila-input-focus: 0 0 0 3px rgba(124, 58, 237, 0.22);
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --primary: #d29bfd;
    --primary-dark: #be79e1;
    --secondary: #d38aff;
    --secondary-dark: #8b5cf6;
    --accent: #a78bfa;
    --surface: #141124;
    --surface-dark: #0b0914;
    --bg-body: #0b0914;
    --bg-body-dark: #0b0914;

    --lila-bg: #0b0914;
    --lila-surface: #141124;
    --lila-primary: #d29bfd;
    --lila-primary-hover: #e5c2ff;
    --lila-sidebar: #100d1c;

    --shadow-lila-card: 0 4px 20px -2px rgba(7, 4, 16, 0.5);
    --shadow-lila-card-hover: 0 10px 25px -4px rgba(210, 155, 253, 0.22);
    --shadow-lila-input: 0 2px 6px 0 rgba(0, 0, 0, 0.2);
    --shadow-lila-input-focus: 0 0 0 3px rgba(210, 155, 253, 0.3);
  }

  html {
    accent-color: var(--lila-primary);
  }

  ::selection {
    background-color: rgba(190, 121, 225, 0.24);
    color: #1e1033;
  }

  :root[data-theme="dark"] ::selection {
    background-color: rgba(210, 155, 253, 0.28);
    color: #faf5ff;
  }

  dialog {
    margin: auto;
  }

  /* View Transitions (Smooth cross-fade + micro slide) */
  ::view-transition-old(root) {
    animation: 220ms cubic-bezier(0.4, 0, 0.2, 1) both lila-fade-out;
  }
  ::view-transition-new(root) {
    animation: 220ms cubic-bezier(0.4, 0, 0.2, 1) both lila-fade-in;
  }

  @keyframes lila-fade-out {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-3px); }
  }

  @keyframes lila-fade-in {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Button click ripple effect */
  .ripple {
    position: absolute;
    border-radius: 50%;
    transform: scale(0);
    animation: lila-ripple 600ms linear;
    background-color: rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }

  @keyframes lila-ripple {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }

  /* Drawer backdrops and modals */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background-color: rgba(11, 9, 20, 0.55);
    backdrop-filter: blur(4px);
    opacity: 0;
    /* A closed (transparent) backdrop must never block clicks on the page. */
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    right: 0;
    width: 20rem;
    max-width: 85vw;
    z-index: 9999;
    background-color: var(--lila-surface);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
  }

  .drawer.open {
    transform: translateX(0);
  }

  /* Carousel */
  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  .carousel-item {
    scroll-snap-align: start;
    flex-shrink: 0;
  }

  @layer components {
    .lila-card,
    .card {
      background-color: var(--lila-surface);
      border-radius: 20px;
      box-shadow: var(--shadow-lila-card);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid rgba(231, 222, 247, 0.9);
    }

    :root[data-theme="dark"] .lila-card,
    :root[data-theme="dark"] .card {
      border: 1px solid rgba(38, 31, 61, 0.9);
      box-shadow: var(--shadow-lila-card);
    }

    .text-lila {
      color: var(--lila-primary);
    }

    :root[data-theme="dark"] .text-lila {
      color: var(--lila-primary);
    }

    .lila-card:hover,
    .card:hover {
      box-shadow: var(--shadow-lila-card-hover);
    }

    .lila-link {
      background-color: transparent;
      color: var(--lila-primary);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .lila-link:hover {
      color: var(--lila-primary-hover);
    }

    .lila-btn,
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      border: 1px solid transparent;
      text-decoration: none;
      position: relative;
      overflow: hidden;
    }

    .lila-btn-primary,
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      border: 1px solid transparent;
      background-color: var(--lila-primary);
      color: #ffffff;
      box-shadow: 0 2px 8px -1px rgba(124, 58, 237, 0.32);
      text-decoration: none;
      position: relative;
      overflow: hidden;
    }

    .lila-btn-primary:hover,
    .btn-primary:hover {
      background-color: var(--lila-primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 4px 14px -1px rgba(124, 58, 237, 0.42);
    }

    :root[data-theme="dark"] .lila-btn-primary,
    :root[data-theme="dark"] .btn-primary {
      background-color: var(--lila-primary);
      color: #140a24;
    }

    :root[data-theme="dark"] .lila-btn-primary:hover,
    :root[data-theme="dark"] .btn-primary:hover {
      background-color: var(--lila-primary-hover);
    }

    .lila-btn-secondary,
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      background-color: transparent;
      color: var(--lila-primary);
      border: 1.5px solid var(--lila-primary);
      text-decoration: none;
    }

    .lila-btn-secondary:hover,
    .btn-secondary:hover {
      background-color: var(--lila-primary);
      color: #ffffff;
      transform: translateY(-1px);
    }

    :root[data-theme="dark"] .lila-btn-secondary,
    :root[data-theme="dark"] .btn-secondary {
      color: var(--lila-primary);
    }

    :root[data-theme="dark"] .lila-btn-secondary:hover,
    :root[data-theme="dark"] .btn-secondary:hover {
      background-color: var(--lila-primary);
      color: #140a24;
    }

    .lila-btn-outline,
    .btn-outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      background-color: transparent;
      border: 1px solid rgba(128, 128, 128, 0.3);
      text-decoration: none;
    }

    .lila-btn-outline:hover,
    .btn-outline:hover {
      background-color: rgba(124, 58, 237, 0.06);
      border-color: var(--lila-primary);
      transform: translateY(-1px);
    }

    :root[data-theme="dark"] .lila-btn-outline:hover,
    :root[data-theme="dark"] .btn-outline:hover {
      background-color: rgba(210, 155, 253, 0.08);
    }

    .btn-danger,
    .btn-error {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      border: none;
      background-color: #ef4444;
      color: #ffffff;
      text-decoration: none;
    }

    .btn-danger:hover,
    .btn-error:hover {
      background-color: #dc2626;
      transform: translateY(-1px);
    }

    :root[data-theme="dark"] .btn-danger,
    :root[data-theme="dark"] .btn-error {
      background-color: #f87171;
      color: #131314;
    }

    .btn-success {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      border: none;
      background-color: #10b981;
      color: #ffffff;
      text-decoration: none;
    }

    .btn-success:hover {
      background-color: #059669;
      transform: translateY(-1px);
    }

    :root[data-theme="dark"] .btn-success {
      background-color: #34d399;
      color: #131314;
    }

    .btn-warning {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      border: none;
      background-color: #f59e0b;
      color: #ffffff;
      text-decoration: none;
    }

    .btn-warning:hover {
      background-color: #d97706;
      transform: translateY(-1px);
    }

    :root[data-theme="dark"] .btn-warning {
      background-color: #fbbf24;
      color: #131314;
    }

    .btn-info {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      border: none;
      background-color: #06b6d4;
      color: #ffffff;
      text-decoration: none;
    }

    .btn-info:hover {
      background-color: #0891b2;
      transform: translateY(-1px);
    }

    :root[data-theme="dark"] .btn-info {
      background-color: #22d3ee;
      color: #131314;
    }

    .btn-light {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      background-color: #ffffff;
      border: 1px solid #e7def7;
      color: #1e293b;
      text-decoration: none;
    }

    .btn-light:hover {
      background-color: #f4effc;
      transform: translateY(-1px);
    }

    :root[data-theme="dark"] .btn-light {
      background-color: #1b1630;
      border-color: rgba(190, 121, 225, 0.2);
      color: #e2e8f0;
    }

    .btn-dark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.625rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      gap: 0.5rem;
      outline: none;
      border: none;
      background-color: #0b0914;
      color: #ffffff;
      text-decoration: none;
    }

    .btn-dark:hover {
      background-color: #1e1833;
      transform: translateY(-1px);
    }

    :root[data-theme="dark"] .btn-dark {
      background-color: #ffffff;
      color: #0b0914;
    }

    .form-control,
    .input-lila {
      width: 100%;
      padding: 0.75rem 1.25rem;
      background-color: var(--lila-surface);
      border-radius: 14px;
      box-shadow: var(--shadow-lila-input);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid rgba(128, 128, 128, 0.25);
      outline: none;
      color: inherit;
    }

    :root[data-theme="dark"] .form-control,
    :root[data-theme="dark"] .input-lila {
      border-color: rgba(190, 121, 225, 0.2);
      box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.25);
      background-color: #100d1c;
    }

    .form-control:focus,
    .input-lila:focus {
      box-shadow: var(--shadow-lila-input-focus);
      border-color: var(--lila-primary);
      transform: translateY(-1px);
    }
  }
</style>
{% endif %}