    --color-lila-primary: var(--lila-primary, #1a73e8);
    --color-lila-primary-hover: var(--lila-primary-hover, #1557b0);
    --color-lila-sidebar: var(--lila-sidebar, #f1f5f9);
  }

  :root {
    --primary: #1a73e8;
    --primary-dark: #1557b0;
    --secondary: #8b5cf6;
    --secondary-dark: #7c3aed;
    --accent: #06b6d4;
    --surface: #ffffff;
    --surface-dark: #1e293b;
    --bg-body: #f8fafc;
    --bg-body-dark: #0f172a;

    --lila-bg: #f8fafc;
