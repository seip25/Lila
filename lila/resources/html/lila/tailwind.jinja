    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    right: 0;
    width: 20rem;
    max-width: 85vw;
    z-index: 9999;
    background-color: var(--lila-surface);
    transform: translateX(100%);
