    --lila-primary: #1a73e8;
    --lila-primary-hover: #1557b0;
    --lila-sidebar: #f1f5f9;
  }

  :root[data-theme="dark"] {
    --primary: #60a5fa;
    --primary-dark: #3b82f6;
    --secondary: #a78bfa;
    --secondary-dark: #8b5cf6;
    --accent: #22d3ee;
    --surface: #1e293b;
    --surface-dark: #0f172a;
    --bg-body: #0b1120;
    --bg-body-dark: #0b1120;

    --lila-bg: #0b1120;
    --lila-surface: #1e293b;
    --lila-primary: #60a5fa;
    --lila-primary-hover: #93c5fd;
    --lila-sidebar: #131b2e;
  }

  /* View Transitions (Smooth cross-fade + micro slide) */
  ::view-transition-old(root) {
    animation: 220ms cubic-bezier(0.4, 0, 0.2, 1) both lila-fade-out;
  }
  ::view-transition-new(root) {
    animation: 220ms cubic-bezier(0.4, 0, 0.2, 1) both lila-fade-in;
  }

  @keyframes lila-fade-out {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-3px); }
  }

  @keyframes lila-fade-in {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Button click ripple effect */
  .ripple {
    position: absolute;
    border-radius: 50%;
    transform: scale(0);
    animation: lila-ripple 600ms linear;
    background-color: rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }

  @keyframes lila-ripple {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }

