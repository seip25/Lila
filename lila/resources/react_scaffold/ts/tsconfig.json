{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@lila": ["./resources/react/lila/index.tsx"],
      "@lila/*": ["./resources/react/lila/*"],
      "@/*": ["./resources/react/*"]
    }
  },
  "include": ["resources/react"]
}
