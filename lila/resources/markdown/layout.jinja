<!DOCTYPE html>
<html lang="{{ lang | default('en') }}" data-theme="light">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>{{ title | default('Lila Document') }}</title>
  <link rel="icon" type="image/x-icon" href="{{ public('img/lila.png') }}">
  {% include "lila/tailwind.jinja" %}
  {% for css in css_files %}
  <link rel="stylesheet" href="{{ css }}">
  {% endfor %}
  {% for js in js_files %}
  <script src="{{ js }}"></script>
  {% endfor %}
</head>

<body class="bg-bg-body dark:bg-bg-body-dark text-slate-800 dark:text-slate-200 font-sans min-h-screen py-10 px-4">
  <div id="lila-outlet" data-lila-outlet class="max-w-4xl mx-auto">
    <article class="card p-8 md:p-12 prose dark:prose-invert max-w-none">
      {{ content | safe }}
    </article>
  </div>

  <script src="{{ public('js/lila-client.js') }}"></script>
</body>

</html>
