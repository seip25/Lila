# ─────────────────────────────────────────────────────────────────────────────
# Lila Framework — MySQL 8.0 Low-Memory Production Configuration
#
# Reduces MySQL RAM footprint from ~550MB+ down to ~60MB - 90MB.
# Optimized specifically for 1GB - 2GB RAM VPS servers and multi-project hosting.
# ─────────────────────────────────────────────────────────────────────────────

[mysqld]
# ─── Performance Schema (Biggest RAM consumer in MySQL 8) ────────────────────
# Performance schema alone consumes ~200MB - 400MB of RAM.
# Disabling it is essential for low-memory VPS environments.
performance_schema = OFF

# ─── Memory & InnoDB Buffer Pool ────────────────────────────────────────────
# Default is 128MB. 64MB is ideal for 1GB-2GB VPS; reduce to 32MB if running 3+ projects.
innodb_buffer_pool_size = 64M
innodb_log_buffer_size = 4M
innodb_redo_log_capacity = 16M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_stats_on_metadata = 0

# ─── Connection & Thread Tuning ─────────────────────────────────────────────
# Limit max connections to prevent thread spawning RAM explosion
max_connections = 50
max_connect_errors = 100
thread_stack = 196K
thread_cache_size = 8
table_open_cache = 64
table_definition_cache = 128
open_files_limit = 1024

# ─── Per-Query Buffers (Kept compact to avoid per-connection spikes) ────────
key_buffer_size = 16M
sort_buffer_size = 256K
read_buffer_size = 128K
read_rnd_buffer_size = 256K
join_buffer_size = 256K
tmp_table_size = 16M
max_heap_table_size = 16M
binlog_cache_size = 32K

# ─── Networking & DNS ───────────────────────────────────────────────────────
# Disable reverse DNS lookups for instant container-to-container connections
skip-name-resolve
skip-host-cache

# ─── Character Set & Timezone ───────────────────────────────────────────────
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
