{% extends layout | default('lila/base.jinja') %}
{% block title %}{{ title | default(translate['recover_password'] | default('Recover Password')) }} - Lila Framework{% endblock %}

{% block content %}
<main
    class="min-h-screen bg-bg-body dark:bg-bg-body-dark flex flex-col justify-center items-center px-4 py-12 transition-colors duration-300 font-sans">
    <div class="card w-full max-w-md p-8 transform hover:scale-101">
        <h3 class="text-lila text-3xl text-center mb-4">
            {{ translate['recover_password'] | default(translate['recover password'] | default('Recover password')) }}
        </h3>

        <p class="text-xs text-slate-500 dark:text-slate-400 text-center mb-6 leading-relaxed">
            {{ translate['forgot_instruction'] | default('Enter your email address and we will send you a link to reset your password.') }}
        </p>

        <form id="forgot-password-form" class="space-y-6">
            {{ csrf_input | safe }}
            <div>
                <label for="email" class="block text-sm font-bold text-slate-600 dark:text-slate-400 mb-2">{{ translate['email'] | default('Email Address') }}</label>
                <input type="email" id="email" name="email"
                    class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 text-sm"
                    required placeholder="you@example.com">
            </div>

            <button type="submit" class="btn btn-primary w-full justify-center">
                {{ translate['send'] | default('Send') }}
            </button>

            <div class="text-center pt-2">
                <p class="text-sm text-slate-500">
                    <a href="/login" class="btn btn-outline text-primary">{{ translate['sign_in'] | default(translate['login'] | default('Sign In')) }}</a>
                </p>
            </div>

            <p id="message" class="mt-2 text-center text-sm font-semibold"></p>
        </form>
    </div>
</main>

<script>
    document.getElementById('forgot-password-form').addEventListener('submit', async function (event) {
        event.preventDefault();
        const form = event.target;
        const formData = new FormData(form);
        const message = document.getElementById('message');
        try {
            const result = await Http('/forgot-password', 'POST', Object.fromEntries(formData));
            message.className = 'text-green-500 mt-2 text-center text-sm font-semibold';
            message.textContent = result.msg;
        } catch (error) {
            message.className = 'text-red-500 mt-2 text-center text-sm font-semibold';
            message.textContent = error.message || '{{ translate["error"] | default("An error occurred.") }}';
        }
    });
</script>
{% endblock %}
