# ─── Server Configuration ────────────────────────────────
SECRET_KEY='change_me_to_a_random_secret_key'
DEBUG=True
PORT=8000
HOST="127.0.0.1"
JIT=False
WORKERS="2"

# ─── Application URL ────────────────────────────────────
# In development, left empty it defaults to http://HOST:PORT automatically.
# In production, set to your canonical domain (e.g., https://my-lila-app.com).
APP_URL=""

# ─── Project Metadata ───────────────────────────────────
TITLE_PROJECT='Lila'
VERSION_PROJECT='2.0.0'
DESCRIPTION_PROJECT='Modern Full-Stack Python Application'
LANG_DEFAULT='en'

# ─── SEO Defaults ───────────────────────────────────────
DESCRIPTION_DEFAULT="Built with Lila Framework v2.0"
KEYWORDS_DEFAULT="python, starlette, spa, web, framework"
AUTHOR_DEFAULT=""

# ─── Cache Driver (memory | redis) ───────────────────────
# Default: in-memory LRU cache (zero infrastructure needed).
CACHE_DRIVER="memory"

# If CACHE_DRIVER="redis" (optional, requires: pip install "lila-framework[redis]"):
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=""

# ─── Database Configuration ──────────────────────────────
# By default, Lila v2.0 uses SQLite Async with WAL mode for maximum performance.
DB_TYPE="sqlite"
DB_NAME="lila"
# If using PostgreSQL / MySQL (optional):
# DB_HOST="127.0.0.1"
# DB_PORT=5432
# DB_USER="postgres"
# DB_PASSWORD=""

# ─── AI Integration (core/ia.py) ─────────────────────────
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""

# ─── Better Auth OAuth Providers ─────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
