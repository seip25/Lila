# ─── Server ────────────────────────────────────────────
SECRET_KEY='change_me_to_a_random_secret_key'
DEBUG=True
PORT=8000
HOST="127.0.0.1"
JIT=False
WORKERS=2

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PORT_HOST=6379

# ─── Application URL ──────────────────────────────────
# Production URL for sitemaps, robots.txt, and canonical links.
# Leave empty in development — defaults to http://HOST:PORT automatically.
# Example: APP_URL="https://my-lila-app.com"
APP_URL=""

# ─── Project Metadata ─────────────────────────────────
TITLE_PROJECT='Lila'
VERSION_PROJECT='1.0.0'
DESCRIPTION_PROJECT=''
LANG_DEFAULT='en'

# ─── SEO Defaults ─────────────────────────────────────
DESCRIPTION_DEFAULT="A high-performance Python web framework"
KEYWORDS_DEFAULT="Python, web, framework, asgi, api"
AUTHOR_DEFAULT=""

# ─── Docker / VPS Multi-Project Configuration ─────────
# Each Lila project on the same host/VPS should have a unique project name and ports
LILA_PROJECT_NAME=lila_app
DB_NAME=lila_db
DB_USER=root
DB_PASSWORD=root
DB_PORT=3306