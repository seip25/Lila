# ─── Server ────────────────────────────────────────────
SECRET_KEY='change_me_to_a_random_secret_key'
DEBUG=True
PORT=8000
HOST="127.0.0.1"
JIT=False
WORKERS="max"
MINIFY_HTML=True

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PORT_HOST=6379

# ─── Application URL ──────────────────────────────────
# English: Production URL for sitemaps, robots.txt, and canonical links.
#          Leave empty in development — the framework uses http://HOST:PORT automatically.
# Español: URL de producción para sitemaps, robots.txt y links canónicos.
#          Dejar vacío en desarrollo — el framework usa http://HOST:PORT automáticamente.
#          Example: APP_URL="https://my-lila-app.com"
APP_URL=""

# ─── Project Metadata ─────────────────────────────────
TITLE_PROJECT='Lila'
VERSION_PROJECT='1'
DESCRIPTION_PROJECT=''
LANG_DEFAULT='en'

# ─── SEO Defaults ─────────────────────────────────────
DESCRIPTION_DEFAULT="A Python web framework"
KEYWORDS_DEFAULT="Python, web, framework"
AUTHOR_DEFAULT=""

# ─── Docker / VPS Multi-Project Deployment ────────────
# English: Multi-project VPS support. Each Lila project on the same VPS should
#          have a unique LILA_PROJECT_NAME, PORT, DB_PORT, and REDIS_PORT_HOST.
# Español: Soporte multi-proyecto en VPS. Cada proyecto Lila en el mismo VPS debe
#          tener un LILA_PROJECT_NAME, PORT, DB_PORT y REDIS_PORT_HOST único.
LILA_PROJECT_NAME=lila_app
DB_NAME=lila_db
DB_USER=root
DB_PASSWORD=root
DB_PORT=3306