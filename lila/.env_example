# ─── Server Configuration ────────────────────────────────
# Generate a real key with: lila secret-key
SECRET_KEY=""
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"
# 1 is ideal for SQLite + memory cache. Use "max" only with Redis and a VPS.
WORKERS="1"

# ─── Application URL ────────────────────────────────────
# Empty = http://HOST:PORT. In production set the canonical HTTPS URL.
APP_URL=""

# ─── Project Metadata ───────────────────────────────────
TITLE_PROJECT='Lila'
VERSION_PROJECT='2.0.0'
DESCRIPTION_PROJECT='Modern Full-Stack Python Application'
LANG_DEFAULT='en'

# ─── SEO Defaults ───────────────────────────────────────
DESCRIPTION_DEFAULT="Built with Lila Framework v2.0"
KEYWORDS_DEFAULT="python, starlette, spa, web, framework"
AUTHOR_DEFAULT=""

# ─── Cache Driver (memory | redis | file) ───────────────
# memory: default, perfect for 1-2 workers.
# redis: only used if the package is installed AND the server is reachable;
#        otherwise Lila falls back to memory automatically.
# file: persistent JSON fallback (app/cache/data).
CACHE_DRIVER="memory"
CACHE_DIR="app/cache/data"
CACHE_MAX_ITEMS=10000
CACHE_DEFAULT_TTL=300
MODEL_CACHE_TTL=5

REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=""

# ─── Database Configuration ──────────────────────────────
# By default, SQLite Async with WAL mode (zero infrastructure).
DB_TYPE="sqlite"
DB_NAME="lila"
# For PostgreSQL / MySQL:
# DB_HOST="127.0.0.1"
# DB_PORT=5432
# DB_USER="postgres"
# DB_PASSWORD=""

# ─── AI Integration (core/ia.py) ─────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ─── Mailer (password reset, optional) ───────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_TLS=True
SMTP_SSL=False

# ─── Better Auth OAuth Providers ─────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ─── Logs (optional) ────────────────────────────────────
# LILA_LOG_DIR="app/logs"
